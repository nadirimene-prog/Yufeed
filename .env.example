# =================================================================
# Yufeed Environment Configuration
# =================================================================
# SECURITY WARNING: Never commit .env files with real credentials!
# Copy this file to .env and update with your actual values.
# =================================================================

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_IN_PRODUCTION_USE_STRONG_PASSWORD
POSTGRES_DB=yufeed
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full database connection string
# IMPORTANT: Use strong password and rotate regularly
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@db:5432/yufeed

# =================================================================
# REDIS CONFIGURATION
# =================================================================
REDIS_URL=redis://redis:6379/0

# CELEX Cache Settings (NEW - Phase 1 Backend Improvements)
# Enable/disable CELEX document caching for 100x performance boost
CELEX_CACHE_ENABLED=true
# Cache TTL in hours (EU documents rarely change)
CELEX_CACHE_TTL_HOURS=24

# =================================================================
# OPENSEARCH CONFIGURATION
# =================================================================
OPENSEARCH_URL=http://opensearch:9200

# OpenSearch Security (REQUIRED FOR PRODUCTION)
# Set to 'true' to enable authentication and SSL
OPENSEARCH_SECURITY_ENABLED=false
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=CHANGE_THIS_OPENSEARCH_PASSWORD
OPENSEARCH_CA_CERT_PATH=/etc/ssl/certs/ca-certificates.crt

# =================================================================
# APPLICATION SECURITY
# =================================================================

# Environment: development, staging, production
# IMPORTANT: Set to 'production' in production deployments
# In production, SECRET_KEY is required and validated for strength
ENVIRONMENT=development

# SECRET_KEY: Used for JWT token signing and encryption
# CRITICAL: Generate a strong random key using:
# python -c "import secrets; print(secrets.token_hex(32))"
# In development, an auto-generated key will be used if not set
# In production, this MUST be set or the app will refuse to start
SECRET_KEY=REPLACE_WITH_RANDOMLY_GENERATED_SECRET_KEY_MINIMUM_32_CHARS

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (comma-separated)
# PRODUCTION: Set to your actual frontend domain
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security Headers
# Enable HSTS for production HTTPS deployments
ENABLE_HSTS=false

# =================================================================
# AI SERVICES
# =================================================================

# Anthropic Claude API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: override the Anthropic model id used for extraction (must be available in your Anthropic account)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI API (fallback when Anthropic is unavailable / out of credits)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4.1

# =================================================================
# EMAIL CONFIGURATION
# =================================================================

# SMTP Settings
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test
SMTP_TLS=false

# Email From Address
EMAILS_FROM_EMAIL=info@yufeed.eu

# =================================================================
# FRONTEND CONFIGURATION
# =================================================================

# API URL that frontend will connect to (browser-side requests)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Internal API URL for SSR (server-side rendering) requests
# In Docker: use the service name (api:8000)
# In Kubernetes: use the internal service DNS name
API_INTERNAL_URL=http://api:8000

# Debug mode (enables detailed error messages in API responses)
# WARNING: Set to 'false' in production
DEBUG=true

# =================================================================
# REGULATORY INGESTION
# =================================================================
RSS_USER_AGENT=Yufeed/1.0
EURLEX_LANGUAGES=en,fr
EURLEX_SEARCH_TERMS_FR=prestataire de services de paiement;services de paiement;etablissement de monnaie electronique;monnaie electronique;prestataire de services sur actifs numeriques;actifs numeriques;crypto-actifs;psan;mica
EURLEX_SEARCH_TERMS_EN=payment service provider;payment services;electronic money institution;electronic money;crypto-asset service provider;virtual asset service provider;crypto-assets;emd2;psd2;psd3;mica;casp
EURLEX_SEARCH_PAGE_SIZE=100
EURLEX_OJ_START_DATE=2023-10-01
LEGIFRANCE_JORF_RSS_URL=https://legifrss.org/latest

# =================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# =================================================================
# Before deploying to production, ensure:
# [ ] All passwords changed to strong, unique values
# [ ] SECRET_KEY is randomly generated (32+ characters)
# [ ] OPENSEARCH_SECURITY_ENABLED=true with valid credentials
# [ ] ENABLE_HSTS=true for HTTPS deployments
# [ ] ALLOWED_ORIGINS set to your actual domain
# [ ] ANTHROPIC_API_KEY is valid and has appropriate quotas
# [ ] Database backups configured
# [ ] SSL/TLS certificates installed
# [ ] All credentials stored securely (not in git)
# [ ] Rotate credentials regularly (every 90 days)
# =================================================================
