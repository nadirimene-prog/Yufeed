# Database Configuration
# For local development, use SQLite (no setup required)
DATABASE_URL=sqlite:///./compliance.db

# For production, use PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yufeed

# Optional Services (can be disabled for local development)
REDIS_URL=redis://localhost:6379/0
OPENSEARCH_URL=http://localhost:9200

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=1025

# Environment (development/production)
# ENVIRONMENT=production

# ===========================================
# REGULATORY INTELLIGENCE PIPELINE
# ===========================================

# AI Configuration (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS_POLICY=2000
ANTHROPIC_MAX_TOKENS_EXTRACTION=4000
AI_DAILY_COST_THRESHOLD_USD=10.0
AI_COST_CHECK_SCHEDULE=0 7 * * *
CONTENT_BACKFILL_SCHEDULE=0 2 1 * *

# RAG (Retrieval Augmented Generation)
RAG_INDEX_ENABLED=true
RAG_INDEX_NAME=legal_chunks
RAG_EMBEDDING_PROVIDER=sentence_transformers
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIM=1024
RAG_CHUNK_SIZE=2000
RAG_CHUNK_OVERLAP=200
RAG_HYBRID_ALPHA=0.5

# Optional OpenAI-compatible LLM (for RAG benchmarks)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Regulatory Ingestion
RSS_USER_AGENT=Yufeed/1.0
INGESTION_DISABLED_SOURCES=
INGESTION_WEEKLY_SCHEDULE=0 3 * * 0
EURLEX_LANGUAGES=en,fr,de
EURLEX_SEARCH_TERMS_FR=prestataire de services de paiement;services de paiement;etablissement de monnaie electronique;monnaie electronique;prestataire de services sur actifs numeriques;actifs numeriques;crypto-actifs;psan;mica
EURLEX_SEARCH_TERMS_EN=payment service provider;payment services;electronic money institution;electronic money;crypto-asset service provider;virtual asset service provider;crypto-assets;emd2;psd2;psd3;mica;casp
EURLEX_SEARCH_TERMS_DE=geldwaesche;terrorismusfinanzierung;krypto-asset;krypto-asset-dienstleister;mica;psd2;psd3;zahlungdienste;e-geld
EURLEX_SEARCH_PAGE_SIZE=100
EURLEX_OJ_START_DATE=2023-10-01
LEGIFRANCE_JORF_RSS_URL=
LEGIFRANCE_FILTER_KEYWORDS=blanchiment;terrorisme;aml;financement du terrorisme;sanctions;crypto;actifs numeriques;psan;mica

# Deadline Monitoring
DEADLINE_ALERT_THRESHOLDS=90,60,30,7,1
DEADLINE_CHECK_SCHEDULE=0 8 * * *
OVERDUE_CHECK_SCHEDULE=0 9 * * *

# Email Escalation (Optional)
ESCALATION_ENABLED=false
ESCALATION_DAYS_THRESHOLD=7
MLRO_EMAIL=mlro@company.com

# Policy Templates
POLICY_TEMPLATES_AUTO_SEED=true

# Feature Flags
FEATURE_AI_POLICY_WRITER=false
FEATURE_MONITORING_SUGGESTIONS=false
FEATURE_DEADLINE_ALERTS=true
FEATURE_AUDIT_TRAIL=true
