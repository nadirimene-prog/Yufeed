[run]
source = src
omit =
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */migrations/*
    */alembic/*
    ai/*
    api/*
    ingestion/*
    services/*
    integrations/*
    ml/*
    monitoring/*
    tasks/*
    worker.py
    debug_rag.py
    audit/middleware.py
    src/ai/*
    src/api/*
    src/ingestion/*
    src/services/*
    src/integrations/*
    src/ml/*
    src/monitoring/*
    src/tasks/*
    src/worker.py
    src/debug_rag.py
    src/audit/middleware.py

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov
