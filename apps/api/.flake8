[flake8]
max-line-length = 100
extend-ignore = E501,E402
exclude =
    __pycache__,
    .venv,
    src/ai,
    src/api,
    src/auth,
    src/cache,
    src/compliance,
    src/ingestion,
    src/integrations,
    src/ml,
    src/models,
    src/monitoring,
    src/plugins,
    src/schemas,
    src/services,
    src/tasks,
    src/utils,
    tests
per-file-ignores =
    src/ai/*.py: E302,E305,E402,E131,W293,W391,F401,E722,E712,F541,F841,W291
    src/ai/agents/*.py: E302,E305,E402,E131,W293,F401
    src/ai/prompts/*.py: E302,E305,E402,E131,W293,W391,F401,F841
    src/api/*.py: F401,E302,E305,E402,E712,E741,E261,W293,W291,F841
    src/integrations/*.py: F401,E302,E305,E402,E741
    src/integrations/**/*.py: F401,E302,E305,E402,E741
    src/main.py: F401,E302,E303,E305,E402
    src/middleware/*.py: F401,E302,E305,E402,F824
    src/ml/*.py: F401,E302,E305,E402,F541
    src/ml/**/*.py: F401,E302,E305,E402,F541
    src/models/*.py: F401,E302,E303,E261,W293,W291,W391
    src/monitoring/*.py: E302,E305,E402,E131,W293,W391,E306,F541
    src/plugins/*.py: E302,E501
    src/routers_autoload.py: F401,E302,E261,W391
    src/schemas/*.py: F401,F403,E302,W293,W291,E261,E501
    src/search.py: E302,E111,E117,E501
    src/services/*.py: E302,E305,E402,E501,F401,E712,E722
    src/tasks/*.py: E302,E305,E402,E501,F401
    src/tenancy/*.py: F401,E501,E712
    src/utils/*.py: E302,E501
    src/websocket/*.py: F401,E305,E402,F541
    src/worker.py: E302,E305
    tests/*.py: F401,F841,F541,E731
    tests/**/*.py: F401,F841,F541,E731
    scripts/*.py: F401,F841,E402
