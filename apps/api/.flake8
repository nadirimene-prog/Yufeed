[flake8]
max-line-length = 100
extend-ignore = E501
per-file-ignores =
    src/ai/*.py: E302,E305,E402,E131,W293,W391,F401,E722,E712,F541
    src/ai/agents/*.py: E302,E305,E402,E131,W293,F401
    src/ai/prompts/*.py: E302,E305,E402,E131,W293,W391,F401
    src/monitoring/*.py: E302,E305,E402,E131,W293,W391,E306,F541
    src/plugins/*.py: E302,E501
    src/routers_autoload.py: F401,E302,E261,W391
    src/schemas/*.py: F401,F403,E302,W293,W291,E261,E501
    src/search.py: E302,E111,E117,E501
    src/services/*.py: E302,E305,E402,E501,F401,E712,E722
    src/tasks/*.py: E302,E305,E402,E501,F401
    src/tenancy/*.py: F401,E501,E712
    src/utils/*.py: E302,E501
    src/websocket/*.py: F401,E305,E402,F541
    src/worker.py: E302,E305
